<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.wlmosv_png.wpaforge">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Android 13+ 扫描周边 WiFi 需要此项。
         注意：不能加 android:usesPermissionFlags="neverForLocation" ——
         加了之后系统认为本应用不需要位置来推断，会在部分 ROM 上
         把扫描结果里的 SSID/BSSID 抹掉（或直接返回空列表），
         表现为"扫描到 0 个网络"但权限全部已授予。
         WPAForge 需要完整 SSID 做字典派生，所以必须不带这个标志。 -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Android 12 及以下依赖定位权限才能拿到扫描结果 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ConnectivityManager.requestNetwork() 必需，缺了会直接 SecurityException -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：让破解在后台/锁屏时继续 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      前台服务类型从 dataSync 改为 connectedDevice。
      理由：Android 15 对 dataSync 类型的前台服务有「每 24 小时最多 6 小时」的限制，
      而本应用一次完整任务实测约 5.3 小时（3336 条 × 5.7 秒），已经压在上限上；
      connectedDevice 表示「与外部设备交互」，与「反复关联 WiFi AP」语义相符，且无时长上限。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 保活：把本进程归入「媒体播放」档位，ColorOS 后台冻结就绕过了 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 无 root 场景下的兜底：引导用户关闭电池优化（有 root 时本应用会直接写白名单） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      保活悬浮窗：任务进行时显示一个 1×1 透明窗口。
      目的不是给用户看，而是让系统认为本应用「有可见窗口」——
      实测 ColorOS 会冻结纯后台应用（即使持 WakeLock、待机桶已是 EXEMPTED、
      即使有前台服务）。授权由 root 自动完成，无需用户操作。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!--
      Shizuku 包可见性（2026-11-20）。

      Android 11+ 的包可见性默认把「别的应用装没装」藏起来 ——
      不加这段，getPackageInfo("moe.shizuku.privileged.api") 会抛
      NameNotFoundException，于是探测把「Shizuku 装了」误判成「没装」，
      整条无 Root 自动连接路径被自己挡住（用户看到的就是「点了没反应」
      或退回系统确认框）。

      同时声明 Shizuku 的权限，用于 checkSelfPermission / requestPermission。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.manager" />
        <intent>
            <action android:name="moe.shizuku.manager.intent.action.BinderReceived" />
        </intent>
    </queries>
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:name=".App"
        android:label="WPAForge"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/app_desc"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/WPFTheme">

        <service
            android:name=".CrackService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于" />

        <!-- 公开 API 可行性验证器（2026-11-20 第四阶段）。
             独立入口，只做「一次一条凭据」的验证，不是破解引擎。
             exported=false：只能由本应用或 adb（同 uid/root）启动。 -->
        <activity
            android:name=".PublicApiProbeActivity"
            android:exported="false"
            android:label="公开 API 验证" />

        <activity
            android:name=".DictActivity"
            android:exported="false"
            android:label="字典管理" />

        <activity
            android:name=".ui.LanProbeActivity"
            android:exported="false"
            android:label="局域网设备探测"
            android:screenOrientation="portrait" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Shizuku 的 binder 入口（2026-11-20，关键）。

          Shizuku 不是通过 startService 把 binder 给你的，而是通过一个
          ContentProvider 在进程启动时把 binder 塞进你的进程。
          不注册这个 provider，Shizuku.pingBinder() 永远 false，
          应用也**不会出现在 Shizuku 的「已授权应用」列表里** ——
          用户看到的就是「列表里根本没有 WPAForge」，无从授权。

          permission 用 INTERACT_ACROSS_USERS_FULL 是官方要求：
          防止其它普通应用通过这个 provider 拿到 binder。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="io.github.wlmosv_png.wpaforge.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          Shizuku 13 的 V3 协议标记。官方 aar 的 manifest 里就有这一条，
          不声明的话 Shizuku 侧会按旧协议处理授权回调。
        -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>
</manifest>
