<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.wlmosv_png.wpaforge">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Android 13+ 扫描周边 WiFi 需要此项。
         注意：不能加 android:usesPermissionFlags="neverForLocation" ——
         加了之后系统认为本应用不需要位置来推断，会在部分 ROM 上
         把扫描结果里的 SSID/BSSID 抹掉（或直接返回空列表），
         表现为"扫描到 0 个网络"但权限全部已授予。
         WPAForge 需要完整 SSID 做字典派生，所以必须不带这个标志。 -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Android 12 及以下依赖定位权限才能拿到扫描结果 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ConnectivityManager.requestNetwork() 必需，缺了会直接 SecurityException -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：让破解在后台/锁屏时继续 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      前台服务类型从 dataSync 改为 connectedDevice。
      理由：Android 15 对 dataSync 类型的前台服务有「每 24 小时最多 6 小时」的限制，
      而本应用一次完整任务实测约 5.3 小时（3336 条 × 5.7 秒），已经压在上限上；
      connectedDevice 表示「与外部设备交互」，与「反复关联 WiFi AP」语义相符，且无时长上限。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 无 root 场景下的兜底：引导用户关闭电池优化（有 root 时本应用会直接写白名单） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      保活悬浮窗：任务进行时显示一个 1×1 透明窗口。
      目的不是给用户看，而是让系统认为本应用「有可见窗口」——
      实测 ColorOS 会冻结纯后台应用（即使持 WakeLock、待机桶已是 EXEMPTED、
      即使有前台服务）。授权由 root 自动完成，无需用户操作。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ================= Shizuku 集成（必须的三件套）=================
         缺任何一样都会表现为：
           · 应用不出现在 Shizuku 的「已授权应用」列表里
           · Shizuku.pingBinder() 永远返回 false
         这三条来自 Shizuku 官方 API 模块的 manifest，也与其 demo 一致。 -->

    <!-- ① 声明使用 Shizuku 的 API 权限。不声明的话 Shizuku 不会把这
         个应用列入可授权列表。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Android 11+ 包可见性：不声明就查不到 Shizuku 是否安装，
         会导致"明明装了却提示去下载"。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.manager" />
        <package android:name="rikka.shizuku" />
    </queries>

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".App"
        android:label="WPAForge"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/app_desc"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <service
            android:name=".CrackService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于" />

        <activity
            android:name=".DictActivity"
            android:exported="false"
            android:label="字典管理" />

        <activity
            android:name=".ui.LanProbeActivity"
            android:exported="false"
            android:label="局域网设备探测"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ② 声明支持 Shizuku V3 协议（用了新版 API 就需要） -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- ③ Shizuku 的 binder 是通过这个 ContentProvider 递给客户端的，
             不是普通 Service。没有它，Shizuku.getBinder() 拿不到东西，
             pingBinder() 永远是 false，也就永远不会出现在授权列表里。
             如果只想支持 Sui，可以移除本 provider。 -->
        <provider
            android:name="io.github.wlmosv_png.wpaforge.shizuku.SafeShizukuProvider"
            android:authorities="io.github.wlmosv_png.wpaforge.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
